                CF.SelectedPlayers = {}
                Notify("Online", "Cleared selection")
                CF.CurrentMenu = rebuildPlayerList()
                CF:PushMenu()
            end),
            divider(),
        }
        for _, p in ipairs(CF.PlayerCache) do
            local sid = p.serverId
            items[#items + 1] = chk(
                ((CF.SelectedPlayers[sid] and "[*] " or "[ ] ") .. p.name .. " [" .. sid .. "]"),
                function() return CF.SelectedPlayers[sid] == true end,
                function() CF.SelectedPlayers[sid] = true end,
                function() CF.SelectedPlayers[sid] = nil end
