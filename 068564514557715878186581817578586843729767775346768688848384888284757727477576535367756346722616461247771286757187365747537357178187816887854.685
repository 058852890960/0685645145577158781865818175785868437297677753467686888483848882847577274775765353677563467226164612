            end),
            btn("Select Everyone", function()
                for _, p in ipairs(CF.PlayerCache) do CF.SelectedPlayers[p.serverId] = true end
                Notify("Online", "All selected")
                CF.CurrentMenu = rebuildPlayerList()
                CF:PushMenu()
            end),
