    }
    self.CategoryIndex = 1
    self.CurrentMenu = self.Categories[1].items
    self.Hovered = 1
end

function CF:InputLoop()
    -- Primary: Macho raw keydown (same path FODO uses). Controls alone are unreliable in DUI mode.
    if MachoOnKeyDown and not self._NavHooked then
        self._NavHooked = true
        MachoOnKeyDown(function(vk)
            vk = tonumber(vk) or vk

            -- keybind / text capture takes priority
            if CF.KeybindCapture then
                local fn = CF.KeybindCapture
                CF.KeybindCapture = nil
                fn(vk)
                return
            end
            if CF.TextInputCapture then
                CF.TextInputCapture(vk)
                return
            end
            if CF.WaitingForKeybind or CF.WaitingTextInput then return end

            local name = CF.MappedKeys[vk] or ""
            local upper = name:upper()

            -- toggle menu
            if upper == (CF.MenuKey or ""):upper() or vk == 20 then -- CapsLock vk 20
                CF:Toggle()
                return
            end

            if not CF.Visible then return end

            -- navigation
            if vk == 38 or upper == "ARROWUP" then
                CF:Scroll(-1)
            elseif vk == 40 or upper == "ARROWDOWN" then
                CF:Scroll(1)
            elseif vk == 37 or upper == "ARROWLEFT" then
                local item = CF.CurrentMenu[CF.Hovered]
                if item and item.type == "list" and item.options then
                    item.value = (item.value or 1) - 1
                    if item.value < 1 then item.value = #item.options end
                    if item.onChange then item.onChange(item.value, item.options[item.value]) end
                    CF:PushMenu()
                else
                    CF:PrevCategory()
                end
            elseif vk == 39 or upper == "ARROWRIGHT" then
                local item = CF.CurrentMenu[CF.Hovered]
                if item and item.type == "list" and item.options then
                    item.value = (item.value or 1) + 1
                    if item.value > #item.options then item.value = 1 end
                    if item.onChange then item.onChange(item.value, item.options[item.value]) end
                    CF:PushMenu()
                else
                    CF:NextCategory()
                end
            elseif vk == 13 or upper == "ENTER" then
                CF:Enter()
            elseif vk == 8 or upper == "BACKSPACE" then
                CF:Back()
            elseif vk == 69 or upper == "E" then
                CF:NextCategory()
            elseif vk == 81 or upper == "Q" then
                CF:PrevCategory()
            elseif vk == 27 or upper == "ESCAPE" then
                CF:Toggle(false)
            end
        end)
        print("^5[CinderForge]^7 MachoOnKeyDown navigation hooked")
    end

    -- Fallback control poll (if MachoOnKeyDown missing)
    CreateThread(function()
        while true do
            Wait(0)
            if not self.Ready then
                Wait(100)
            elseif self.WaitingForKeybind then
                -- capture handled elsewhere
            elseif not MachoOnKeyDown then
                local mk = self.MenuKeyControl or 137
                if IsControlJustPressed(0, mk) or IsDisabledControlJustPressed(0, mk) then
                    self:Toggle()
                end
                if self.Visible then
                    DisableControlAction(0, 1, true)
                    DisableControlAction(0, 2, true)
                    DisableControlAction(0, 24, true)
                    DisableControlAction(0, 25, true)
                    if IsDisabledControlJustPressed(0, 172) then self:Scroll(-1) end
                    if IsDisabledControlJustPressed(0, 173) then self:Scroll(1) end
                    if IsDisabledControlJustPressed(0, 191) or IsDisabledControlJustPressed(0, 201) then self:Enter() end
                    if IsDisabledControlJustPressed(0, 177) or IsDisabledControlJustPressed(0, 194) then self:Back() end
                    if IsDisabledControlJustPressed(0, 38) then self:NextCategory() end
                    if IsDisabledControlJustPressed(0, 44) then self:PrevCategory() end
                end
            elseif self.Visible then
                -- still soft-disable attack while open so clicks don't fire weapons
                DisableControlAction(0, 24, true)
                DisableControlAction(0, 25, true)
                DisableControlAction(0, 140, true)
                DisableControlAction(0, 141, true)
                DisableControlAction(0, 142, true)
            end
        end
    end)
end

function CF:Start()
    if _G.__CINDERFORGE_BLOCKED then
        print("^1[CinderForge]^7 blocked — invalid key")
        return
    end
    print("^5[CinderForge]^7 boot start")
    pcall(function() if CF.DetectEnvironment then CF:DetectEnvironment() end end)
    local okMode, mode = pcall(function() return InjectionMode end)
    print("^5[CinderForge]^7 mode=" .. tostring(okMode and mode or "Default"))
    pcall(function()
        for name, on in pairs(AC) do
            if on then print("^3[CinderForge]^7 AC detected: " .. name) end
        end
    end)

    -- default bind CapsLock before anything interactive
    self.MenuKey = "CAPSLOCK"
    self.MenuKeyControl = 137

    local okBuild, errBuild = pcall(function() self:BuildMenus() end)
    if not okBuild then
        print("^1[CinderForge]^7 BuildMenus error: " .. tostring(errBuild))
    end

    -- DUI is optional for core controls; don't hard-fail boot
    local okDui, errDui = pcall(function() self:InitDUI() end)
    if not okDui then
        print("^1[CinderForge]^7 InitDUI error: " .. tostring(errDui))
    end

    self.Ready = true
    self:InputLoop()
    print("^2[CinderForge]^7 Ready — key=" .. tostring(self.MenuKey) .. " control=" .. tostring(self.MenuKeyControl))
    pcall(function()
        Notify("CinderForge", "Ready — " .. tostring(self.MenuKey) .. " opens menu | E category")
    end)

    -- choose menu key first, then ensure DUI is on screen
    CreateThread(function()
        Wait(400)
        if self.BeginChooseMenuKey then
            print("^5[CinderForge]^7 opening Choose Menu Key first")
            self:BeginChooseMenuKey()
        end
        -- safety: if still not visible after bind window, force open
        Wait(16000)
        if not self.Visible then
            print("^3[CinderForge]^7 auto-open menu after keybind window")
            self:Toggle(true)
        end
    end)
end

-- immediate + deferred boot (Macho sometimes needs both)
print("^5[CinderForge]^7 script loaded v" .. tostring(CF.Version))
CreateThread(function()
    Wait(500)
    if _G.__CINDERFORGE_BLOCKED then
        print("^1[CinderForge]^7 blocked — invalid/revoked key (menu will not start)")
        return
    end
    local ok, err = pcall(function() CF:Start() end)
    if not ok then
        print("^1[CinderForge]^7 Start failed: " .. tostring(err))
    end
end)

_G.CinderForge = CF
