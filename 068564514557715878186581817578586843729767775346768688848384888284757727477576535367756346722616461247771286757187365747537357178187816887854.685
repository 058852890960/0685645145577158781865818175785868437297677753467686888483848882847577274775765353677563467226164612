local function ResStarted(name)
    local ok, st = pcall(GetResourceState, name)
    return ok and st == "started"
end

-- Framework + AC detection (run after menu key set, also at boot soft)
CF.Framework = "None"
CF.FrameworkResource = "any"
CF.ACName = "None"
CF.InjectTarget = "any"
CF.InjectApi = "auto" -- auto|raw|std|typed
CF.EnvReady = false

local AC = {
    FiveGuard   = false,
    ElectronAC  = false,
    ReaperV4    = false,
    FiniAC      = false,
    Waveshield  = false,
}

local InjectionMode = "Default"

local function DetectFramework()
    if ResStarted("es_extended") or ResStarted("esx") or ResStarted("ESX") then
        return "ESX", (ResStarted("es_extended") and "es_extended") or "esx"
    end
    if ResStarted("qb-core") then
        return "QBCore", "qb-core"
    end
    if ResStarted("qbx_core") then
        return "QBCore", "qbx_core"
    end
    if ResStarted("qbox_core") then
        return "QBCore", "qbox_core"
    end
    return "None", "any"
end

local function DetectAC()
    local ac = {
        FiveGuard   = ResStarted("FiveGuard") or ResStarted("fiveguard") or ResStarted("fg") or ResStarted("fiveguard_ac"),
        ElectronAC  = ResStarted("ElectronAC") or ResStarted("electronac") or ResStarted("electron") or ResStarted("EC_AC"),
        ReaperV4    = ResStarted("ReaperV4") or ResStarted("reaperv4") or ResStarted("reaper") or ResStarted("ReaperV4AC"),
        FiniAC      = ResStarted("FiniAC") or ResStarted("finiac") or ResStarted("fini") or ResStarted("Fini"),
        Waveshield  = ResStarted("WaveShield") or ResStarted("Waveshield") or ResStarted("waveshield") or ResStarted("ws"),
    }
    return ac
end

-- Combination table inspired by reference menus (JAK/FODO style), Cinder-owned
-- Framework x AC → preferred inject target + mode
local function ResolveInjectProfile(fw, fwRes, ac)
    local mode, target, api = "Default", fwRes or "any", "auto"
    if ac.Waveshield then
        mode, target, api = "Raw", (ResStarted("monitor") and "monitor" or "any"), "raw"
    elseif ac.ReaperV4 then
        mode, target, api = "RawSoft", (ResStarted("monitor") and "monitor" or "any"), "raw"
    elseif ac.ElectronAC then
        mode, target, api = "Monitor", (ResStarted("monitor") and "monitor" or "any"), "std"
    elseif ac.FiniAC then
        mode, target, api = "FiniSoft", "any", "typed"
    elseif ac.FiveGuard then
        mode, target, api = "Delayed", (fwRes ~= "any" and fwRes or "any"), "typed"
    else
        -- no AC
        if fw == "ESX" then
            mode, target, api = "Framework", fwRes, "typed"
        elseif fw == "QBCore" then
            mode, target, api = "Framework", fwRes, "typed"
        else
            -- none/none → inject any resource freely
            mode, target, api = "Open", "any", "typed"
        end
    end
    -- if framework none and no AC, force any
    if fw == "None" and not (ac.Waveshield or ac.ReaperV4 or ac.ElectronAC or ac.FiniAC or ac.FiveGuard) then
        mode, target, api = "Open", "any", "typed"
    end
    return mode, target, api
end

function CF:DetectEnvironment()
    local fw, fwRes = DetectFramework()
    local ac = DetectAC()
    AC = ac
    CF.Framework = fw
    CF.FrameworkResource = fwRes
    local mode, target, api = ResolveInjectProfile(fw, fwRes, ac)
    InjectionMode = mode
    CF.InjectTarget = target
    CF.InjectApi = api
    CF.ACName = "None"
    for name, on in pairs(ac) do
        if on then
            CF.ACName = name
            break
        end
    end
    -- multi-AC label
    local names = {}
    for name, on in pairs(ac) do if on then names[#names+1] = name end end
    if #names > 0 then CF.ACName = table.concat(names, "+") end
    CF.EnvReady = true
    print(("^5[CinderForge]^7 env fw=%s res=%s ac=%s mode=%s target=%s"):format(
        tostring(fw), tostring(fwRes), tostring(CF.ACName), tostring(mode), tostring(target)))
    if Notify then Notify("CinderForge", ("FW:%s | AC:%s | inject→%s"):format(fw, CF.ACName, target)) end
    return fw, CF.ACName, target
end

local function PickInjectTarget(explicit)
    if explicit and explicit ~= "" and explicit ~= "any" then
        if explicit == "monitor" and not ResStarted("monitor") then
            return CF.InjectTarget or "any"
        end
        return explicit
    end
    return CF.InjectTarget or "any"
end

local function runInject(api, t, c, typ)
    typ = typ or 3
    if api == "raw" then
        if MachoInjectResourceRaw then MachoInjectResourceRaw(t, c)
        elseif MachoInjectResource2 then MachoInjectResource2(typ, t, c)
        elseif MachoInjectResource then MachoInjectResource(t, c) end
    elseif api == "typed" then
        if MachoInjectResource2 then MachoInjectResource2(typ, t, c)
        elseif MachoInjectResource then MachoInjectResource(t, c)
        elseif MachoInjectResourceRaw then MachoInjectResourceRaw(t, c) end
    else -- std / auto
        if MachoInjectResource2 then MachoInjectResource2(typ, t, c)
        elseif MachoInjectResource then MachoInjectResource(t, c)
        elseif MachoInjectResourceRaw then MachoInjectResourceRaw(t, c) end
    end
end

local function SafeInject(target, code)
    local t = PickInjectTarget(target)
    local api = CF.InjectApi or "auto"
    local mode = InjectionMode or "Default"
    if mode == "FiniSoft" or mode == "Delayed" then
        CreateThread(function()
            Wait(200 + math.random(80, 420))
            runInject(api, t, code, 3)
        end)
    elseif mode == "Raw" then
        runInject("raw", t == "any" and (ResStarted("monitor") and "monitor" or "any") or t, code, 3)
    elseif mode == "RawSoft" then
        runInject("raw", ResStarted("monitor") and "monitor" or t, code, 3)
    elseif mode == "Monitor" then
        runInject(api, ResStarted("monitor") and "monitor" or t, code, 3)
    elseif mode == "Framework" then
        runInject("typed", t, code, 3)
    elseif mode == "Open" then
        -- none/none: free any
        runInject("typed", "any", code, 3)
    else
        runInject(api, t, code, 3)
    end
end

local function SafeInject2(typ, target, code)
    typ = typ or 3
    local t = PickInjectTarget(target)
    local api = CF.InjectApi or "auto"
    local mode = InjectionMode or "Default"
    if mode == "FiniSoft" or mode == "Delayed" then
        CreateThread(function()
            Wait(180 + math.random(60, 350))
            runInject(api, t, code, typ)
        end)
    elseif mode == "Raw" or mode == "RawSoft" then
        runInject("raw", (mode == "RawSoft" and ResStarted("monitor") and "monitor") or t, code, typ)
    elseif mode == "Open" then
        runInject("typed", "any", code, typ)
    else
        runInject(api, t, code, typ)
    end
end

local function MonitorInject(code)
    local t = ResStarted("monitor") and "monitor" or (CF.InjectTarget or "any")
    if InjectionMode == "Raw" or InjectionMode == "RawSoft" or (AC and AC.Waveshield) then
        runInject("raw", t, code, 3)
    else
        runInject(CF.InjectApi or "typed", t, code, 3)
    end
end

local function FrameworkInject(code)
    -- force framework resource when known
    local t = CF.FrameworkResource or "any"
    if t == "any" then t = PickInjectTarget(nil) end
    SafeInject2(3, t, code)
end



local function RotationToDirection(rot)
    local z = math.rad(rot.z)
    local x = math.rad(rot.x)
    local num = math.abs(math.cos(x))
    return vector3(-math.sin(z) * num, math.cos(z) * num, math.sin(x))
end

local function RequestModelSafe(hash, timeout)
    timeout = timeout or 5000
    if type(hash) == "string" then hash = GetHashKey(hash) end
    if not IsModelValid(hash) and not IsModelInCdimage(hash) then return false end
    RequestModel(hash)
    local t = GetGameTimer()
    while not HasModelLoaded(hash) do
        Wait(10)
        if GetGameTimer() - t > timeout then return false end
    end
    return true
end

function CF:Send(data)
    if not self.DUI then return end
    if not data then return end
    if MachoSendDuiMessage then
        local ok, err = pcall(MachoSendDuiMessage, self.DUI, json.encode(data))
        if not ok then
            print("^1[CinderForge]^7 SendDui failed: " .. tostring(err))
        end
    end
end

function CF:PushMenu()
    local elements = {}
    for i, item in ipairs(self.CurrentMenu) do
        elements[#elements + 1] = {
            label = item.label or "???",
            type = item.type or "button",
            checked = item.checked,
            value = item.value,
            options = item.options,
            desc = item.desc,
        }
    end
    local cats = {}
    for i, c in ipairs(self.Categories) do
        cats[#cats + 1] = c.label or ("Cat " .. i)
    end
    self:Send({
        action = "update",
        elements = elements,
        index = math.max(0, self.Hovered - 1),
        categories = cats,
        categoryIndex = math.max(0, self.CategoryIndex - 1),
        path = self:GetPath(),
        visible = self.Visible,
    })
end

function CF:GetPath()
    local p = {}
    for _, l in ipairs(self.LabelStack) do p[#p + 1] = l end
    if self.Categories[self.CategoryIndex] then
        p[#p + 1] = self.Categories[self.CategoryIndex].label
    end
    return table.concat(p, " > ")
end

function CF:InitDUI()
    local url = CF.DuiUrl or "https://cinderforgelua.vercel.app/"
    print("^5[CinderForge]^7 InitDUI url=" .. tostring(url))
    if not MachoCreateDui then
        print("^1[CinderForge]^7 MachoCreateDui missing")
        pcall(function() Notify("CinderForge", "MachoCreateDui missing") end)
        return
    end
    local ok, dui = pcall(MachoCreateDui, url)
    if not ok or not dui then
        print("^1[CinderForge]^7 MachoCreateDui failed: " .. tostring(dui))
        return
    end
    self.DUI = dui
    -- CRITICAL: reference menu always calls MachoShowDui after create
    if MachoShowDui then
        local okShow, errShow = pcall(MachoShowDui, self.DUI)
        print("^5[CinderForge]^7 MachoShowDui -> " .. tostring(okShow) .. " " .. tostring(errShow or "ok"))
    else
        print("^1[CinderForge]^7 MachoShowDui missing — DUI will stay invisible")
    end
    Wait(600)
    -- push empty/hidden state so the browser surface is transparent
    pcall(function()
        self:Send({ action = "setVisible", visible = false })
    end)
    if MachoHideDui then
        pcall(MachoHideDui, self.DUI)
        print("^5[CinderForge]^7 MachoHideDui after create (game visible)")
    end
    print("^5[CinderForge]^7 DUI ready (hidden) -> " .. tostring(url))
end

function CF:Scroll(dir)
    if not self.CurrentMenu or #self.CurrentMenu == 0 then return end
    local n = #self.CurrentMenu
    repeat
        self.Hovered = self.Hovered + dir
        if self.Hovered < 1 then self.Hovered = n end
        if self.Hovered > n then self.Hovered = 1 end
    until self.CurrentMenu[self.Hovered] and self.CurrentMenu[self.Hovered].type ~= "divider"
    self:Send({ action = "keydown", index = self.Hovered - 1 })
end

function CF:Enter()
    local item = self.CurrentMenu[self.Hovered]
    if not item or item.type == "divider" then return end
    if item.type == "submenu" and item.menu then
        table.insert(self.MenuStack, {
            menu = self.CurrentMenu,
            categories = self.Categories,
            categoryIndex = self.CategoryIndex,
            hovered = self.Hovered,
        })
        table.insert(self.LabelStack, item.label)
        self.CurrentMenu = item.menu
        if item.label == "Options" and self._RebuildPlayerList then
            -- keep options static
        end
        self.Hovered = 1
        self:PushMenu()
        return
    end
    if item.type == "checkbox" then
        item.checked = not item.checked
        if item.checked and item.onEnable then item.onEnable() end
        if not item.checked and item.onDisable then item.onDisable() end
        self:PushMenu()
        return
    end
    if item.type == "list" then
        item.value = (item.value or 1) + 1
        if item.value > #(item.options or {}) then item.value = 1 end
        if item.onChange then item.onChange(item.value, item.options[item.value]) end
        self:PushMenu()
        return
    end
    if item.action then item.action() end
end

function CF:Back()
    if #self.MenuStack > 0 then
        local last = table.remove(self.MenuStack)
        table.remove(self.LabelStack)
        self.CurrentMenu = last.menu
        self.Categories = last.categories or self.Categories
        self.CategoryIndex = last.categoryIndex or self.CategoryIndex
        self.Hovered = last.hovered or 1
        self:PushMenu()
    else
        self:Toggle(false)
    end
end

function CF:NextCategory()
    if not self.Categories or #self.Categories == 0 then return end
    self.CategoryIndex = self.CategoryIndex + 1
    if self.CategoryIndex > #self.Categories then self.CategoryIndex = 1 end
    local cat = self.Categories[self.CategoryIndex]
    if cat and cat.label == "Online" and self._RebuildPlayerList then
        cat.items = self._RebuildPlayerList()
    end
    self.CurrentMenu = cat and cat.items or {}
    self.Hovered = 1
    self.MenuStack = {}
    self.LabelStack = {}
    self:PushMenu()
end

function CF:PrevCategory()
    if not self.Categories or #self.Categories == 0 then return end
    self.CategoryIndex = self.CategoryIndex - 1
    if self.CategoryIndex < 1 then self.CategoryIndex = #self.Categories end
    local cat = self.Categories[self.CategoryIndex]
    if cat and cat.label == "Online" and self._RebuildPlayerList then
        cat.items = self._RebuildPlayerList()
    end
    self.CurrentMenu = cat and cat.items or {}
    self.Hovered = 1
    self.MenuStack = {}
    self.LabelStack = {}
    self:PushMenu()
end

function CF:Toggle(state)
    if state == nil then state = not self.Visible end
    self.Visible = state
    if state then
        if not self.DUI then
            self:InitDUI()
        end
        if self.DUI and MachoShowDui then
            pcall(MachoShowDui, self.DUI)
        end
        self:PushMenu()
        self:Send({ action = "setVisible", visible = true })
        print("^5[CinderForge]^7 menu visible=true")
    else
        self:Send({ action = "setVisible", visible = false })
        if self.DUI and MachoHideDui then
            pcall(MachoHideDui, self.DUI)
        end
        print("^5[CinderForge]^7 menu visible=false")
    end
end

function CF:RefreshPlayers()
    self.PlayerCache = {}
    local myId = PlayerId()
    local mySid = GetPlayerServerId(myId)
    local seen = {}
    -- all active clients (vMenu-style: full server player list, not distance filtered)
    for _, pid in ipairs(GetActivePlayers()) do
        if pid ~= myId then
            local sid = GetPlayerServerId(pid)
            if sid and not seen[sid] then
                seen[sid] = true
                local ped = GetPlayerPed(pid)
                local name = GetPlayerName(pid) or ("ID " .. tostring(sid))
                self.PlayerCache[#self.PlayerCache + 1] = {
                    id = pid, serverId = sid, name = name, ped = ped,
                }
            end
        end
    end
    -- also probe server id range for players that exist but may not stream nearby
    for sid = 1, 128 do
        if sid ~= mySid and not seen[sid] then
            local pid = GetPlayerFromServerId(sid)
            if pid ~= nil and pid ~= -1 and pid ~= myId then
                local ped = GetPlayerPed(pid)
                local name = GetPlayerName(pid)
                if name and name ~= "**Invalid**" and name ~= "" then
                    seen[sid] = true
                    self.PlayerCache[#self.PlayerCache + 1] = {
                        id = pid, serverId = sid, name = name, ped = ped,
                    }
                end
            end
        end
    end
    table.sort(self.PlayerCache, function(a, b) return a.serverId < b.serverId end)
end

function CF:GetSelectedPeds()
    local out = {}
    for sid, selected in pairs(self.SelectedPlayers) do
        if selected then
            local found = nil
            for _, p in ipairs(self.PlayerCache) do
                if p.serverId == sid then found = p; break end
            end
            local pid = GetPlayerFromServerId(sid)
            local ped = (pid and pid ~= -1) and GetPlayerPed(pid) or (found and found.ped)
            local name = found and found.name or (pid and GetPlayerName(pid)) or ("ID " .. tostring(sid))
            if ped and DoesEntityExist(ped) then
                out[#out + 1] = { id = pid, serverId = sid, name = name, ped = ped }
            elseif found then
                out[#out + 1] = found
            end
        end
    end
    return out
end

function CF:ForSelected(fn)
    local list = self:GetSelectedPeds()
    if #list == 0 then Notify("Online", "No players selected"); return end
    for _, p in ipairs(list) do
        if DoesEntityExist(p.ped) then fn(p) end
    end
end


function CF:SetGodMode(state)
    self.GodMode = state
    local ped = PlayerPedId()
    SetEntityInvincible(ped, state)
    SetPlayerInvincible(PlayerId(), state)
    if state then
        SafeInject2(3, "any", [[
            if not _G.__CF_GOD then
                _G.__CF_GOD = true
                CreateThread(function()
                    while _G.__CF_GOD do
                        local p = PlayerPedId()
                        SetEntityInvincible(p, true)
                        SetEntityProofs(p, true, true, true, true, true, true, true, true)
                        if GetEntityHealth(p) < GetEntityMaxHealth(p) then
                            SetEntityHealth(p, GetEntityMaxHealth(p))
                        end
                        Wait(500)
                    end
                end)
            end
            _G.__CF_GOD = true
        ]])
    else
        SafeInject2(3, "any", [[ _G.__CF_GOD = false; local p=PlayerPedId(); SetEntityInvincible(p,false); SetEntityProofs(p,false,false,false,false,false,false,false,false) ]])
        SetEntityInvincible(ped, false)
        SetPlayerInvincible(PlayerId(), false)
    end
end

function CF:SetInvisible(state)
    self.Invisible = state
    local ped = PlayerPedId()
    SetEntityVisible(ped, not state, false)
    SetLocalPlayerVisibleLocally(not state)
    NetworkSetEntityInvisibleToNetwork(ped, state)
end

function CF:SetNoRagdoll(state)
    self.NoRagdoll = state
    SetPedCanRagdoll(PlayerPedId(), not state)
    if state then
        SafeInject2(3, "any", [[
            _G.__CF_NORAG = true
            CreateThread(function()
                while _G.__CF_NORAG do
                    SetPedCanRagdoll(PlayerPedId(), false)
                    Wait(200)
                end
            end)
        ]])
    else
        SafeInject2(3, "any", [[ _G.__CF_NORAG = false; SetPedCanRagdoll(PlayerPedId(), true) ]])
    end
end

function CF:Heal()
    local ped = PlayerPedId()
    SetEntityHealth(ped, GetEntityMaxHealth(ped))
    SetPedArmour(ped, 100)
    ClearPedBloodDamage(ped)
    Notify("Self", "Healed + Armour")
end

function CF:Revive()
    local ped = PlayerPedId()
    local coords = GetEntityCoords(ped)
    NetworkResurrectLocalPlayer(coords.x, coords.y, coords.z, GetEntityHeading(ped), true, false)
    SetEntityHealth(ped, GetEntityMaxHealth(ped))
    ClearPedTasksImmediately(ped)
    Notify("Self", "Revived")
end

function CF:Uncuff()
    local ped = PlayerPedId()
    ClearPedTasksImmediately(ped)
    DetachEntity(ped, true, false)
    FreezeEntityPosition(ped, false)
    SetEnableHandcuffs(ped, false)
    SetPedCanBeDraggedOut(ped, true)
    SetPedConfigFlag(ped, 120, false)
    SetPedConfigFlag(ped, 122, false)
    UncuffPed(ped)
    -- anims
    for _, pair in ipairs({
        { "mp_arresting", "idle" },
        { "mp_arrest_paired", "crook_p2_back_right" },
        { "random@mugging3", "handsup_standing_base" },
        { "anim@move_m@prisoner_cuffed", "idle" },
        { "anim@move_m@prisoner_cuffed", "wading" },
    }) do
        if IsEntityPlayingAnim(ped, pair[1], pair[2], 3) then
            StopAnimTask(ped, pair[1], pair[2], 1.0)
        end
    end
    -- framework / job events (broad net)
    local events = {
        "police:client:DeEscort",
        "police:client:GetUncuffed",
        "police:client:UnCuffPlayer",
        "esx_policejob:unrestrain",
        "esx_policejob:unrestrainPlayer",
        "QBCore:Client:OnPlayerUnload", -- noop-safe-ish, skip
        "handcuff:client:Uncuff",
        "handcuffs:client:Uncuff",
        "Cuffs:Client:Uncuff",
        "wasabi_police:uncuff",
        "qbx_police:client:uncuff",
        "ox_police:client:uncuff",
        "rsd_cuff:client:uncuff",
        "dpemotes:client:cancelEmote",
        "emote:cancel",
        "animations:client:EmoteCancel",
    }
    for _, e in ipairs(events) do
        pcall(function() TriggerEvent(e) end)
        pcall(function() TriggerEvent(e, false) end)
        pcall(function() TriggerEvent(e, GetPlayerServerId(PlayerId())) end)
    end
    pcall(function() TriggerServerEvent("police:server:SetHandcuffStatus", false) end)
    pcall(function() TriggerServerEvent("esx_policejob:unrestrain") end)
    pcall(function() TriggerServerEvent("handcuff:server:Uncuff") end)
    pcall(function() TriggerServerEvent("wasabi_police:uncuffPlayer") end)
    Notify("Self", "Uncuff broad attempt")
end

function CF:TogglePickThrow(state)
    self.PickThrow = state
    if state then
        -- reference-style injection (type 3) for stable thread context + AC soft path
        local code = [[
            if fgawjFmaDjdALaO == nil then fgawjFmaDjdALaO = false end
            fgawjFmaDjdALaO = true
            local holdingEntity, holdingCarEntity, holdingPed = false, false, false
            local heldEntity, entityType = nil, nil
            local function RotationToDirection(rotation)
                local adjustedRotation = vector3(
                    (math.pi / 180) * rotation.x,
                    (math.pi / 180) * rotation.y,
                    (math.pi / 180) * rotation.z
                )
                return vector3(
                    -math.sin(adjustedRotation.z) * math.abs(math.cos(adjustedRotation.x)),
                    math.cos(adjustedRotation.z) * math.abs(math.cos(adjustedRotation.x)),
                    math.sin(adjustedRotation.x)
                )
            end
            local function DrawText3Ds(x, y, z, text)
                local onScreen, _x, _y = World3dToScreen2d(x, y, z)
                if onScreen then
                    SetTextScale(0.0, 0.35)
                    SetTextFont(0)
                    SetTextProportional(1)
                    SetTextColour(255,255,255,215)
                    SetTextDropshadow(0,0,0,155)
                    SetTextEdge(2,0,0,0,150)
                    SetTextEntry("STRING")
                    SetTextCentre(1)
                    AddTextComponentString(text)
                    DrawText(_x,_y)
                end
            end
            CreateThread(function()
                while fgawjFmaDjdALaO do
                    Wait(0)
                    if holdingEntity and heldEntity then
                        local playerPed = PlayerPedId()
                        local headPos = GetPedBoneCoords(playerPed, 0x796e, 0.0, 0.0, 0.0)
                        DrawText3Ds(headPos.x, headPos.y, headPos.z + 0.5, "[E] Pick Up  |  [Y] Drop/Throw")
                        if holdingCarEntity and not IsEntityPlayingAnim(playerPed, 'anim@mp_rollarcoaster', 'hands_up_idle_a_player_one', 3) then
                            RequestAnimDict('anim@mp_rollarcoaster')
                            while not HasAnimDictLoaded('anim@mp_rollarcoaster') do Wait(50) end
                            TaskPlayAnim(playerPed, 'anim@mp_rollarcoaster', 'hands_up_idle_a_player_one', 8.0, -8.0, -1, 50, 0, false, false, false)
                        elseif not holdingCarEntity and not IsEntityPlayingAnim(playerPed, 'anim@heists@box_carry@', 'idle', 3) then
                            RequestAnimDict('anim@heists@box_carry@')
                            while not HasAnimDictLoaded('anim@heists@box_carry@') do Wait(50) end
                            TaskPlayAnim(playerPed, 'anim@heists@box_carry@', 'idle', 8.0, -8.0, -1, 50, 0, false, false, false)
                        end
                        if not IsEntityAttached(heldEntity) then
                            holdingEntity, holdingCarEntity, holdingPed = false, false, false
                            heldEntity = nil
                            ClearPedTasks(playerPed)
                        end
                    end
                end
            end)
            CreateThread(function()
                while fgawjFmaDjdALaO do
                    Wait(0)
                    local playerPed = PlayerPedId()
                    local camPos = GetGameplayCamCoord()
                    local camRot = GetGameplayCamRot(2)
                    local direction = RotationToDirection(camRot)
                    local dest = vector3(camPos.x + direction.x * 10.0, camPos.y + direction.y * 10.0, camPos.z + direction.z * 10.0)
                    local rayHandle = StartShapeTestRay(camPos.x, camPos.y, camPos.z, dest.x, dest.y, dest.z, -1, playerPed, 0)
                    local _, hit, _, _, entityHit = GetShapeTestResult(rayHandle)
                    local validTarget = false
                    if hit == 1 then
                        entityType = GetEntityType(entityHit)
                        if entityType == 3 or entityType == 2 or entityType == 1 then
                            validTarget = true
                            local headPos = GetPedBoneCoords(playerPed, 0x796e, 0.0, 0.0, 0.0)
                            DrawText3Ds(headPos.x, headPos.y, headPos.z + 0.5, "[E] Pick Up  |  [Y] Drop/Throw")
                        end
                    end
                    if IsDisabledControlJustReleased(0, 38) then
                        if validTarget and not holdingEntity then
                            holdingEntity = true
                            heldEntity = entityHit
                            if entityType == 1 then
                                AttachEntityToEntity(heldEntity, playerPed, GetPedBoneIndex(playerPed, 60309), 0.0, 0.2, 0.0, 0.0, 0.0, 0.0, true, true, false, true, 1, true)
                                holdingPed = true
                            elseif entityType == 2 then
                                holdingCarEntity = true
                                AttachEntityToEntity(heldEntity, playerPed, GetPedBoneIndex(playerPed, 60309), 1.0, 0.5, 0.0, 0.0, 0.0, 0.0, true, true, false, false, 1, true)
                            elseif entityType == 3 then
                                holdingPed = false
                                AttachEntityToEntity(heldEntity, playerPed, GetPedBoneIndex(playerPed, 60309), 0.0, 0.2, 0.0, 0.0, 0.0, 0.0, true, true, false, true, 1, true)
                            end
                        end
                    elseif IsDisabledControlJustReleased(0, 246) then
                        if holdingEntity and heldEntity then
                            DetachEntity(heldEntity, true, true)
                            ApplyForceToEntity(heldEntity, 1, direction.x * 500, direction.y * 500, direction.z * 500, 0.0, 0.0, 0.0, 0, false, true, true, false, true)
                            ClearPedTasks(playerPed)
                            holdingEntity, holdingCarEntity, holdingPed = false, false, false
                            heldEntity = nil
                        end
                    end
                end
            end)
        ]]
        if MachoInjectResource2 then
            MachoInjectResource2(3, "any", code)
        else
            SafeInject2(3, "any", code)
        end
        Notify("Self", "Pick & Throw ON — E pickup / Y throw")
    else
        local off = [[
            fgawjFmaDjdALaO = false
            ClearPedTasks(PlayerPedId())
        ]]
        if MachoInjectResource2 then
            MachoInjectResource2(3, "any", off)
        else
            SafeInject2(3, "any", off)
        end
        Notify("Self", "Pick & Throw OFF")
    end
end

function CF:ToggleFreecam(state)
    self.Freecam = state
    if state then
        self.FreecamMode = self.FreecamMode or 1
        local ped = PlayerPedId()
        local c = GetGameplayCamCoord()
        local r = GetGameplayCamRot(2)
        self.FreecamCam = CreateCam("DEFAULT_SCRIPTED_CAMERA", true)
        SetCamCoord(self.FreecamCam, c.x, c.y, c.z)
        SetCamRot(self.FreecamCam, r.x, r.y, r.z, 2)
        SetCamActive(self.FreecamCam, true)
        RenderScriptCams(true, false, 0, true, true)
        FreezeEntityPosition(ped, true)
        SetEntityVisible(ped, false, false)
        local modesJson = table.concat(self.FreecamModes or {}, ",")
        self:Send({ action = "displayFreecam", visible = true, modeIndex = (self.FreecamMode or 1) - 1, modes = self.FreecamModes })
        SafeInject2(3, "any", [[
            _G.__CF_FC = true
            _G.__CF_FC_MODE = ]] .. tostring(self.FreecamMode or 1) .. [[
            _G.__CF_FC_MODES = { "Default", "Teleport", "Shoot Weapon", "Shoot Vehicle", "Copy Appearance", "Kick from Vehicle", "Hijack Vehicle", "Delete Vehicle", "Detach Wheels", "Blackhole", "Launch" }
            CreateThread(function()
                local speed = 0.35
                local sens = 6.5
                while _G.__CF_FC do
                    Wait(0)
                    -- hide weapon wheel / HUD select while scrolling mods
                    BlockWeaponWheelThisFrame()
                    HideHudComponentThisFrame(19)
                    HideHudComponentThisFrame(20)
                    DisableControlAction(0, 37, true) -- weapon wheel
                    DisableControlAction(0, 14, true)
                    DisableControlAction(0, 15, true)
                    DisableControlAction(0, 16, true)
                    DisableControlAction(0, 17, true)
                    local cam = GetRenderingCam()
                    if cam ~= -1 then
                        local rot = GetCamRot(cam, 2)
                        local coord = GetCamCoord(cam)
                        local mx = GetDisabledControlNormal(0, 1) * sens
                        local my = GetDisabledControlNormal(0, 2) * sens
                        local nx = rot.x - my
                        if nx > 89.0 then nx = 89.0 elseif nx < -89.0 then nx = -89.0 end
                        local nz = rot.z - mx
                        SetCamRot(cam, nx, 0.0, nz, 2)
                        local z = math.rad(nz)
                        local x = math.rad(nx)
                        local num = math.abs(math.cos(x))
                        local fwd = vector3(-math.sin(z)*num, math.cos(z)*num, math.sin(x))
                        local right = vector3(math.cos(z), math.sin(z), 0.0)
                        local spd = speed
                        if IsDisabledControlPressed(0, 21) then spd = speed * 3.2 end
                        if IsDisabledControlPressed(0, 36) then spd = speed * 0.25 end
                        local move = vector3(0,0,0)
                        if IsDisabledControlPressed(0, 32) then move = move + fwd end
                        if IsDisabledControlPressed(0, 33) then move = move - fwd end
                        if IsDisabledControlPressed(0, 34) then move = move - right end
                        if IsDisabledControlPressed(0, 35) then move = move + right end
                        if IsDisabledControlPressed(0, 22) then move = move + vector3(0,0,1) end
                        if IsDisabledControlPressed(0, 44) then move = move - vector3(0,0,1) end
                        local len = #move
                        if len > 0.001 then
                            move = move / len * spd
                            SetCamCoord(cam, coord.x + move.x, coord.y + move.y, coord.z + move.z)
                        end
                        -- vertical list: wheel cycles, drawn top-to-bottom
                        if IsDisabledControlJustPressed(0, 14) then
                            _G.__CF_FC_MODE = _G.__CF_FC_MODE + 1
                            if _G.__CF_FC_MODE > #_G.__CF_FC_MODES then _G.__CF_FC_MODE = 1 end
                        elseif IsDisabledControlJustPressed(0, 15) then
                            _G.__CF_FC_MODE = _G.__CF_FC_MODE - 1
                            if _G.__CF_FC_MODE < 1 then _G.__CF_FC_MODE = #_G.__CF_FC_MODES end
                        end
                        local listY = 0.28
                        for i, name in ipairs(_G.__CF_FC_MODES) do
                            local selected = (i == _G.__CF_FC_MODE)
                            SetTextFont(0) -- Chalet London, clean
                            SetTextScale(0.0, selected and 0.42 or 0.34)
                            SetTextColour(255, 255, 255, selected and 255 or 200)
                            SetTextDropshadow(1, 0, 0, 0, 200)
                            SetTextOutline()
                            SetTextCentre(false)
                            SetTextEntry("STRING")
                            AddTextComponentString((selected and "> " or "  ") .. name)
                            DrawText(0.76, listY + (i - 1) * 0.030)
                        end
                        local modeName = _G.__CF_FC_MODES[_G.__CF_FC_MODE] or "Default"
                        if IsDisabledControlJustPressed(0, 24) then
                            local endPos = coord + fwd * 90.0
                            local ray = StartShapeTestRay(coord.x, coord.y, coord.z, endPos.x, endPos.y, endPos.z, -1, PlayerPedId(), 0)
                            local _, hit, hitPos, _, ent = GetShapeTestResult(ray)
                            local target = hit == 1 and hitPos or endPos
                            if modeName == "Teleport" then
                                SetEntityCoordsNoOffset(PlayerPedId(), target.x, target.y, target.z + 1.0, false, false, false)
                            elseif modeName == "Shoot Weapon" then
                                ShootSingleBulletBetweenCoords(coord.x, coord.y, coord.z, target.x, target.y, target.z, 200, true, GetHashKey("WEAPON_APPISTOL"), PlayerPedId(), true, false, 500.0)
                            elseif modeName == "Shoot Vehicle" then
                                local model = GetHashKey("adder")
                                RequestModel(model)
                                local t = GetGameTimer()
                                while not HasModelLoaded(model) and GetGameTimer()-t < 2000 do Wait(10) end
                                if HasModelLoaded(model) then
                                    local veh = CreateVehicle(model, coord.x, coord.y, coord.z, rot.z, true, false)
                                    SetEntityVelocity(veh, fwd.x * 90.0, fwd.y * 90.0, fwd.z * 90.0)
                                    SetModelAsNoLongerNeeded(model)
                                end
                            elseif modeName == "Copy Appearance" then
                                if hit == 1 and DoesEntityExist(ent) and IsEntityAPed(ent) then
                                    local myPed = PlayerPedId()
                                    for i = 0, 11 do
                                        SetPedComponentVariation(myPed, i, GetPedDrawableVariation(ent, i), GetPedTextureVariation(ent, i), GetPedPaletteVariation(ent, i))
                                    end
                                    for i = 0, 7 do
                                        local prop = GetPedPropIndex(ent, i)
                                        if prop == -1 then ClearPedProp(myPed, i) else SetPedPropIndex(myPed, i, prop, GetPedPropTextureIndex(ent, i), true) end
                                    end
                                end
                            elseif modeName == "Kick from Vehicle" then
                                if hit == 1 and DoesEntityExist(ent) then
                                    local veh = IsEntityAVehicle(ent) and ent or (IsPedInAnyVehicle(ent, false) and GetVehiclePedIsIn(ent, false) or 0)
                                    if veh ~= 0 then
                                        local driver = GetPedInVehicleSeat(veh, -1)
                                        if driver and driver ~= 0 then TaskLeaveVehicle(driver, veh, 16) end
                                    end
                                end
                            elseif modeName == "Hijack Vehicle" then
                                if hit == 1 and DoesEntityExist(ent) then
                                    local veh = IsEntityAVehicle(ent) and ent or 0
                                    if veh ~= 0 then
                                        local me = PlayerPedId()
                                        SetEntityVisible(me, true, false)
                                        SetPedIntoVehicle(me, veh, -1)
                                    end
                                end
                            elseif modeName == "Delete Vehicle" then
                                if hit == 1 and DoesEntityExist(ent) then
                                    local veh = IsEntityAVehicle(ent) and ent or (IsPedInAnyVehicle(ent, false) and GetVehiclePedIsIn(ent, false) or 0)
                                    if veh ~= 0 then SetEntityAsMissionEntity(veh, true, true); DeleteVehicle(veh) end
                                end
                            elseif modeName == "Detach Wheels" then
                                if hit == 1 and DoesEntityExist(ent) and IsEntityAVehicle(ent) then
                                    for i = 0, 7 do BreakOffVehicleWheel(ent, i, true, false, true, false) end
                                end
                            elseif modeName == "Blackhole" then
                                local center = target
                                for _, pool in ipairs({ GetGamePool("CObject"), GetGamePool("CVehicle"), GetGamePool("CPed") }) do
                                    for _, ent in ipairs(pool) do
                                        if DoesEntityExist(ent) and ent ~= PlayerPedId() then
                                            local oc = GetEntityCoords(ent)
                                            local d = #(oc - center)
                                            if d < 55.0 and d > 0.2 then
                                                local dir = (center - oc) / d
                                                local power = (55.0 - d) * 2.5
                                                ApplyForceToEntity(ent, 1, dir.x * power, dir.y * power, dir.z * power + 6.0, 0.0, 0.0, 0.0, 0, false, true, true, false, true)
                                                if IsEntityAVehicle(ent) then
                                                    SetEntityVelocity(ent, dir.x * power * 0.4, dir.y * power * 0.4, dir.z * power * 0.3 + 4.0)
                                                end
                                            end
                                        end
                                    end
                                end
                            elseif modeName == "Launch" then
                                if hit == 1 and DoesEntityExist(ent) then
                                    ApplyForceToEntity(ent, 1, 0.0, 0.0, 90.0, 0,0,0, 0, false, true, true, false, true)
                                end
                            end
                        end
                    end
                end
            end)
        ]])
        Notify("Self", "Freecam ON — vertical mod list / wheel / LMB")
    else
        SafeInject2(3, "any", [[ _G.__CF_FC = false ]])
        self:Send({ action = "displayFreecam", visible = false })
        if self.FreecamCam then
            RenderScriptCams(false, false, 0, true, true)
            DestroyCam(self.FreecamCam, false)
            self.FreecamCam = nil
        end
        local ped = PlayerPedId()
        FreezeEntityPosition(ped, false)
        SetEntityVisible(ped, true, false)
        Notify("Self", "Freecam OFF")
    end
end

function CF:KillSelected(weaponHash)
    weaponHash = weaponHash or GetHashKey("WEAPON_PISTOL")
    self:ForSelected(function(p)
        local c = GetEntityCoords(p.ped)
        ShootSingleBulletBetweenCoords(c.x, c.y, c.z + 1.4, c.x, c.y, c.z, 200, true, weaponHash, PlayerPedId(), true, false, 100.0)
    end)
end

function CF:CageSelected(model)
    model = model or "prop_gold_cont_01"
    if not RequestModelSafe(model) then return end
    local hash = GetHashKey(model)
    self:ForSelected(function(p)
        local c = GetEntityCoords(p.ped)
        local obj = CreateObject(hash, c.x, c.y, c.z - 1.0, true, true, false)
        FreezeEntityPosition(obj, true)
    end)
end

function CF:CloneSelected()
    self:ForSelected(function(p)
        ClonePedToTarget(p.ped, PlayerPedId())
        Notify("Online", "Cloned " .. (p.name or "?"))
    end)
end

function CF:AttachObjectSelected(model)
    model = model or "prop_cs_dildo_01"
    if not RequestModelSafe(model) then return end
    local hash = GetHashKey(model)
    self:ForSelected(function(p)
        local obj = CreateObject(hash, 0, 0, 0, true, true, false)
        AttachEntityToEntity(obj, p.ped, GetPedBoneIndex(p.ped, 31086), 0.1, 0.0, 0.0, 0.0, 90.0, 0.0, true, true, false, true, 1, true)
    end)
end

function CF:AttachFunnySelected()
    local funnies = {"prop_beach_fire","prop_tool_blowtorch","prop_cs_burger_01","prop_cs_hotdog_01","prop_alien_egg_01","prop_toilet_01","prop_wheelbarrow01a","prop_dumpster_01a"}
    self:ForSelected(function(p)
        local m = funnies[math.random(#funnies)]
        if RequestModelSafe(m) then
            local obj = CreateObject(GetHashKey(m), 0, 0, 0, true, true, false)
            AttachEntityToEntity(obj, p.ped, GetPedBoneIndex(p.ped, 31086), 0.15, 0.05, 0.0, 0.0, 90.0, 0.0, true, true, false, true, 1, true)
        end
    end)
end

function CF:AttachVehicleSelected(vehModel)
    vehModel = vehModel or "adder"
    if not RequestModelSafe(vehModel) then return end
    local hash = GetHashKey(vehModel)
    self:ForSelected(function(p)
        local c = GetEntityCoords(p.ped)
        local veh = CreateVehicle(hash, c.x, c.y, c.z + 2.0, 0.0, true, false)
        AttachEntityToEntity(veh, p.ped, -1, 0.0, 0.0, 1.5, 0.0, 0.0, 0.0, false, false, false, false, 2, true)
    end)
end

function CF:CopyOutfitSelected()
    local list = self:GetSelectedPeds()
    if #list == 0 then Notify("Online", "Select a player"); return end
    local p = list[1]
    local targetPed = p.ped
    local myPed = PlayerPedId()
    if not DoesEntityExist(targetPed) then return end
    -- appearance copy (no full ped clone) — FODO-style component/prop transfer
    for i = 0, 11 do
        local drawable = GetPedDrawableVariation(targetPed, i)
        local texture = GetPedTextureVariation(targetPed, i)
        local palette = GetPedPaletteVariation(targetPed, i)
        SetPedComponentVariation(myPed, i, drawable, texture, palette)
    end
    for i = 0, 7 do
        local prop = GetPedPropIndex(targetPed, i)
        local tex = GetPedPropTextureIndex(targetPed, i)
        if prop == -1 then
            ClearPedProp(myPed, i)
        else
            SetPedPropIndex(myPed, i, prop, tex, true)
        end
    end
    -- hair/overlay extras when available
    if GetPedHairColor and SetPedHairColor then
        local h, h2 = GetPedHairColor(targetPed)
        if h then SetPedHairColor(myPed, h, h2 or 0) end
    end
    if GetPedEyeColor and SetPedEyeColor then
        local e = GetPedEyeColor(targetPed)
        if e then SetPedEyeColor(myPed, e) end
    end
    Notify("Online", "Appearance copied from " .. (p.name or "?"))
end

function CF:CrashSelected()
    -- crash.txt style: networked ped flood AT TARGET coords (not local cam/object bombs)
    if not self._CrashThreads then self._CrashThreads = {} end
    self:ForSelected(function(p)
        local sid = p.serverId
        if self._CrashThreads[sid] then
            Notify("Online", "Crash already running on " .. tostring(sid))
            return
        end
        self._CrashThreads[sid] = true
        local targetPed = p.ped
        CreateThread(function()
            -- primary model: Franklin (crash.txt) + skater backup
            local models = { GetHashKey("player_one"), GetHashKey("a_m_m_skater_01"), GetHashKey("a_m_y_skater_01") }
            for _, h in ipairs(models) do
                RequestModel(h)
                local t = GetGameTimer()
                while not HasModelLoaded(h) and GetGameTimer() - t < 3000 do Wait(0) end
            end
            local primary = models[1]
            if not HasModelLoaded(primary) then primary = models[2] end
            Notify("Online", "Ped crash -> " .. (p.name or tostring(sid)))
            local batches = 0
            while CF._CrashThreads[sid] do
                local pid = GetPlayerFromServerId(sid)
                if pid == nil or pid == -1 then
                    CF._CrashThreads[sid] = nil
                    Notify("Online", "Crash stopped — left " .. tostring(sid))
                    break
                end
                local ped = GetPlayerPed(pid)
                if not DoesEntityExist(ped) then
                    Wait(100)
                else
                    local c = GetEntityCoords(ped)
                    -- networked peds on target only (throttled vs original 100@Wait0)
                    for i = 1, 35 do
                        local ox = c.x + math.random(-4, 4)
                        local oy = c.y + math.random(-4, 4)
                        local oz = c.z + math.random(0, 2)
                        local npc = CreatePed(4, primary, ox, oy, oz, 0.0, true, true)
                        if npc and npc ~= 0 then
                            SetEntityAsMissionEntity(npc, true, true)
                            local netId = NetworkGetNetworkIdFromEntity(npc)
                            if netId and netId ~= 0 then
                                SetNetworkIdExistsOnAllMachines(netId, true)
                                SetNetworkIdCanMigrate(netId, true)
                            end
                            -- no FreezeEntity / no cam / no rope on local — those crash US
                        end
                    end
                    batches = batches + 1
                    if batches % 6 == 0 then
                        local alt = models[2]
                        if HasModelLoaded(alt) then
                            for i = 1, 15 do
                                local npc = CreatePed(4, alt, c.x + math.random(-3,3), c.y + math.random(-3,3), c.z, 0.0, true, true)
                                if npc and npc ~= 0 then
                                    SetEntityAsMissionEntity(npc, true, true)
                                    local netId = NetworkGetNetworkIdFromEntity(npc)
                                    if netId and netId ~= 0 then
                                        SetNetworkIdCanMigrate(netId, true)
                                    end
                                end
                            end
                        end
                    end
                end
                Wait(60)
            end
            for _, h in ipairs(models) do SetModelAsNoLongerNeeded(h) end
        end)
    end)
end

function CF:CrashNearby()
    -- crash.txt Franklin army, denser on TARGET only; throttle so OUR client survives
    local me = PlayerPedId()
    local myCoords = GetEntityCoords(me)
    local targets = {}
    for _, id in ipairs(GetActivePlayers()) do
        if id ~= PlayerId() then
            local ped = GetPlayerPed(id)
            if DoesEntityExist(ped) then
                local dist = #(GetEntityCoords(ped) - myCoords)
                if dist < 50.0 and dist > 3.0 then -- skip people on top of us
                    targets[#targets + 1] = { ped = ped, sid = GetPlayerServerId(id), name = GetPlayerName(id) }
                end
            end
        end
    end
    if #targets == 0 then Notify("Troll", "No nearby players (or too close)"); return end
    if self._CrashNearby then
        Notify("Troll", "Nearby crash running — Stop Crash Flags")
        return
    end
    self._CrashNearby = true
    CreateThread(function()
        local pModel = GetHashKey("player_one")
        RequestModel(pModel)
        local t = GetGameTimer()
        while not HasModelLoaded(pModel) and GetGameTimer() - t < 3000 do Wait(0) end
        if not HasModelLoaded(pModel) then
            pModel = GetHashKey("a_m_m_skater_01")
            RequestModel(pModel)
            t = GetGameTimer()
            while not HasModelLoaded(pModel) and GetGameTimer() - t < 2000 do Wait(0) end
        end
        Notify("Troll", "Ped army -> " .. tostring(#targets) .. " (throttled)")
        local waves = 0
        while CF._CrashNearby and waves < 18 do
            waves = waves + 1
            local myC = GetEntityCoords(PlayerPedId())
            for _, tinfo in ipairs(targets) do
                if not DoesEntityExist(tinfo.ped) then
                    local pid = GetPlayerFromServerId(tinfo.sid)
                    if pid and pid ~= -1 then tinfo.ped = GetPlayerPed(pid) end
                end
                if DoesEntityExist(tinfo.ped) then
                    local targetCoords = GetEntityCoords(tinfo.ped)
                    if #(targetCoords - myC) < 2.5 then
                        -- skip this tick if they glued to us
                    else
                        -- 25 peds/wave/target (not 80) — networked at TARGET
                        for i = 1, 25 do
                            local spawnOffset = vector3(
                                targetCoords.x + math.random(-5, 5),
                                targetCoords.y + math.random(-5, 5),
                                targetCoords.z + math.random(0, 2)
                            )
                            -- keep spawn off our body
                            if #(spawnOffset - myC) > 2.0 then
                                local ped = CreatePed(4, pModel, spawnOffset.x, spawnOffset.y, spawnOffset.z, 0.0, true, true)
                                if ped and ped ~= 0 then
                                    SetEntityAsMissionEntity(ped, true, true)
                                    local netId = NetworkGetNetworkIdFromEntity(ped)
                                    if netId and netId ~= 0 then
                                        SetNetworkIdExistsOnAllMachines(netId, true)
                                        SetNetworkIdCanMigrate(netId, true)
                                    end
                                end
                            end
                        end
                    end
                end
            end
            Wait(75) -- let our client breathe (crash.txt used 0; that kills host)
        end
        CF._CrashNearby = false
        SetModelAsNoLongerNeeded(pModel)
        Notify("Troll", "Nearby crash waves done")
    end)
end

function CF:StopCrashSelected()
    if self._CrashThreads then
        for sid in pairs(self._CrashThreads) do self._CrashThreads[sid] = nil end
    end
    self._CrashNearby = false
    if self._SilentCrash then
        for sid in pairs(self._SilentCrash) do self._SilentCrash[sid] = nil end
    end
    Notify("Online", "Crash loops stopped")
end

function CF:LaunchSelected()
    self:ForSelected(function(p)
        SetEntityVelocity(p.ped, 0.0, 0.0, 85.0)
        ApplyForceToEntity(p.ped, 1, 0.0, 0.0, 120.0, 0.0, 0.0, 0.0, 0, false, true, true, false, true)
    end)
end

function CF:KickFromVehicleSelected()
    self:ForSelected(function(p)
        if IsPedInAnyVehicle(p.ped, false) then
            TaskLeaveVehicle(p.ped, GetVehiclePedIsIn(p.ped, false), 16)
            ClearPedTasksImmediately(p.ped)
        end
    end)
end

function CF:DeleteVehicleSelected()
    self:ForSelected(function(p)
        local v = GetVehiclePedIsIn(p.ped, false)
        if v ~= 0 then
            SetEntityAsMissionEntity(v, true, true)
            DeleteVehicle(v)
        else
            local c = GetEntityCoords(p.ped)
            local veh = GetClosestVehicle(c.x, c.y, c.z, 6.0, 0, 70)
            if veh ~= 0 then SetEntityAsMissionEntity(veh, true, true); DeleteVehicle(veh) end
        end
    end)
end

function CF:SpectateSelected()
    local list = self:GetSelectedPeds()
    if #list == 0 then Notify("Online", "Select one player"); return end
    local p = list[1]
    if self.Spectating and self.SpectateTarget == p.id then
        NetworkSetInSpectatorMode(false, p.ped)
        self.Spectating = false
        self.SpectateTarget = nil
        Notify("Online", "Spectate OFF")
    else
        NetworkSetInSpectatorMode(true, p.ped)
        self.Spectating = true
        self.SpectateTarget = p.id
        Notify("Online", "Spectating " .. (p.name or "?"))
    end
end

function CF:StealOxInventory()
    if not ResStarted("ox_inventory") then
        Notify("Online", "ox_inventory not running")
        return
    end
    self:ForSelected(function(p)
        TriggerServerEvent("ox_inventory:stealItems", p.serverId)
        TriggerEvent("ox_inventory:steal", p.serverId)
        Notify("Online", "Inventory move request -> " .. (p.name or "?"))
    end)
end

function CF:StealthNPC(model)
    model = model or "a_m_m_skater_01"
    if not RequestModelSafe(model) then return end
    local hash = GetHashKey(model)
    local me = PlayerPedId()
    local c = GetEntityCoords(me)
    local f = GetEntityForwardVector(me)
    local spawn = c + f * 3.0
    local ped = CreatePed(4, hash, spawn.x, spawn.y, spawn.z, GetEntityHeading(me), true, true)
    SetEntityVisible(ped, false, false)
    SetPedAsEnemy(ped, true)
    TaskCombatPed(ped, me, 0, 16)
    CreateThread(function()
        Wait(800)
        SetEntityVisible(ped, true, false)
    end)
end

function CF:StealthObject(model)
    model = model or "prop_container_01a"
    if not RequestModelSafe(model) then return end
    local hash = GetHashKey(model)
    local c = GetEntityCoords(PlayerPedId())
    local obj = CreateObject(hash, c.x, c.y, c.z - 50.0, true, true, false)
    SetEntityVisible(obj, false, false)
    Wait(50)
    SetEntityCoords(obj, c.x + 1.0, c.y, c.z, false, false, false, false)
    SetEntityVisible(obj, true, false)
    FreezeEntityPosition(obj, true)
end

function CF:SpawnVehicle(model)
    model = model or "adder"
    if not RequestModelSafe(model) then Notify("Vehicle", "Invalid model"); return end
    local hash = GetHashKey(model)
    local ped = PlayerPedId()
    local c = GetEntityCoords(ped)
    local h = GetEntityHeading(ped)
    local veh = CreateVehicle(hash, c.x + 2.0, c.y, c.z, h, true, false)
    SetPedIntoVehicle(ped, veh, -1)
    SetVehicleEngineOn(veh, true, true, false)
    SetVehicleNumberPlateText(veh, "CINDER")
    Notify("Vehicle", "Spawned " .. model)
end

function CF:VehicleFlip()
    local v = GetVehiclePedIsIn(PlayerPedId(), false)
    if v == 0 then return end
    local c = GetEntityCoords(v)
    SetEntityCoords(v, c.x, c.y, c.z + 1.2, false, false, false, false)
    SetEntityRotation(v, 0.0, 0.0, GetEntityHeading(v), 2, true)
end

function CF:VehicleMaxTune()
    local v = GetVehiclePedIsIn(PlayerPedId(), false)
    if v == 0 then return end
    SetVehicleModKit(v, 0)
    for i = 0, 49 do
        local m = GetNumVehicleMods(v, i)
        if m > 0 then SetVehicleMod(v, i, m - 1, false) end
    end
    ToggleVehicleMod(v, 18, true)
    ToggleVehicleMod(v, 22, true)
    SetVehicleTyresCanBurst(v, false)
    SetVehicleWindowTint(v, 1)
    Notify("Vehicle", "Max tuned")
end

function CF:VehicleGod(state)
    local v = GetVehiclePedIsIn(PlayerPedId(), false)
    if v == 0 then return end
    SetEntityInvincible(v, state)
    SetVehicleCanBeVisiblyDamaged(v, not state)
    SetVehicleTyresCanBurst(v, not state)
end

function CF:TeleportWaypoint()
    local blip = GetFirstBlipInfoId(8)
    if not DoesBlipExist(blip) then Notify("Teleport", "No waypoint"); return end
    local c = GetBlipInfoIdCoord(blip)
    local ped = PlayerPedId()
    local z = c.z
    for i = 1, 40 do
        SetEntityCoordsNoOffset(ped, c.x, c.y, z + i * 2.0, false, false, false)
        Wait(20)
        local found, ground = GetGroundZFor_3dCoord(c.x, c.y, z + i * 2.0, false)
        if found then
            SetEntityCoordsNoOffset(ped, c.x, c.y, ground + 1.0, false, false, false)
            Notify("Teleport", "Arrived at waypoint")
            return
        end
    end
    SetEntityCoordsNoOffset(ped, c.x, c.y, c.z + 2.0, false, false, false)
end

function CF:TeleportCoords(x, y, z)
    SetEntityCoordsNoOffset(PlayerPedId(), x + 0.0, y + 0.0, z + 0.0, false, false, false)
end

function CF:FPSFlood(model, count)
    model = model or "prop_ld_ferris_wheel"
    count = tonumber(count) or 40
    if not RequestModelSafe(model) then return end
    local hash = GetHashKey(model)
    local c = GetEntityCoords(PlayerPedId())
    local code = string.format([[
        CreateThread(function()
            local hash = %d
            local cx, cy, cz = %.3f, %.3f, %.3f
            local n = %d
            for i = 1, n do
                local o = CreateObject(hash, cx + math.random(-12, 12), cy + math.random(-12, 12), cz + math.random(0, 6), true, true, false)
                if o and o ~= 0 then SetEntityAsMissionEntity(o, true, true) end
                if i %% 4 == 0 then Wait(25 + math.random(10, 40)) end
            end
        end)
    ]], hash, c.x, c.y, c.z, count)
    SafeInject2(3, "any", code)
    Notify("FPS", "Flood x" .. count .. " (" .. model .. ")")
end

function CF:GiveAllWeapons()
    local ped = PlayerPedId()
    local list = {
        "WEAPON_PISTOL","WEAPON_COMBATPISTOL","WEAPON_APPISTOL","WEAPON_PISTOL50",
        "WEAPON_MICROSMG","WEAPON_SMG","WEAPON_ASSAULTSMG","WEAPON_COMBATPDW",
        "WEAPON_ASSAULTRIFLE","WEAPON_CARBINERIFLE","WEAPON_ADVANCEDRIFLE","WEAPON_SPECIALCARBINE",
        "WEAPON_PUMPSHOTGUN","WEAPON_ASSAULTSHOTGUN","WEAPON_HEAVYSHOTGUN",
        "WEAPON_SNIPERRIFLE","WEAPON_HEAVYSNIPER","WEAPON_MARKSMANRIFLE",
        "WEAPON_GRENADELAUNCHER","WEAPON_RPG","WEAPON_MINIGUN","WEAPON_RAILGUN",
        "WEAPON_GRENADE","WEAPON_STICKYBOMB","WEAPON_MOLOTOV","WEAPON_PIPEBOMB",
        "WEAPON_KNIFE","WEAPON_BAT","WEAPON_MACHETE","WEAPON_SWITCHBLADE",
    }
    for _, w in ipairs(list) do
        local h = GetHashKey(w)
        GiveWeaponToPed(ped, h, 999, false, true)
        SetPedInfiniteAmmo(ped, true, h)
    end
    Notify("Weapons", "All weapons granted")
end

function CF:SpoofWeapon(weapon)
    weapon = weapon or "WEAPON_PISTOL"
    local ped = PlayerPedId()
    local h = GetHashKey(weapon)
    GiveWeaponToPed(ped, h, 250, false, true)
    SetCurrentPedWeapon(ped, h, true)
    Notify("Weapons", "Equipped " .. weapon)
end


local function divider()
    return { type = "divider", label = "────────────" }
end
local function btn(label, action, desc)
    return { type = "button", label = label, action = action, desc = desc }
end
local function chk(label, get, on, off, desc)
    return { type = "checkbox", label = label, checked = get and get() or false, onEnable = on, onDisable = off, desc = desc }
end
local function sub(label, menu, desc)
    return { type = "submenu", label = label, menu = menu, desc = desc }
end
local function lst(label, options, onChange, desc)
    return { type = "list", label = label, options = options, value = 1, onChange = onChange, desc = desc }
end


function CF:ApplyMenuKey(label, control, vk)
    label = tostring(label or "INSERT"):upper()
    if label == "`" then label = "GRAVE" end
    self.MenuKey = label
    if control then
        self.MenuKeyControl = control
    elseif self.KeyLabelToControl[label] then
        self.MenuKeyControl = self.KeyLabelToControl[label]
    elseif vk and self.VKToFivem[vk] then
        self.MenuKeyControl = self.VKToFivem[vk]
    end
    Notify("Interface", "Menu key set to " .. self.MenuKey)
    self:Send({ action = "notify", title = "Menu Key", text = self.MenuKey })
    if self.DetectEnvironment then self:DetectEnvironment() end
end


function CF:BeginChooseMenuKey()
    if self.WaitingForKeybind then return end
    self.WaitingForKeybind = true
    local wasVisible = self.Visible
    if wasVisible then self:Toggle(false) end
    Notify("Interface", "Press a key — shown in window (ESC cancel)")
    if self.DUI and MachoHideDui then pcall(MachoHideDui, self.DUI) end
    self:Send({ action = "setVisible", visible = false })
    self:Send({
        action = "updateKeyboard",
        visible = true,
        title = "Choose Menu Key",
        value = "Press any key...",
    })
    -- keep DUI keyboard panel visible for feedback
    if self.DUI and MachoShowDui then pcall(MachoShowDui, self.DUI) end

    CreateThread(function()
        local done = false
        local function finish(label, control, vk)
            if done then return end
            done = true
            CF.WaitingForKeybind = false
            CF.KeybindCapture = nil
            if label then
                CF:Send({
                    action = "updateKeyboard",
                    visible = true,
                    title = "Menu Key Set",
                    value = tostring(label),
                })
                CF:ApplyMenuKey(label, control, vk)
                Wait(700)
            else
                CF:Send({ action = "updateKeyboard", visible = true, title = "Cancelled", value = "-" })
                Wait(400)
            end
            CF:Send({ action = "updateKeyboard", visible = false, title = "", value = "" })
            Wait(100)
            if CF.DUI and MachoShowDui then pcall(MachoShowDui, CF.DUI) end
            CF.Visible = false
            CF:Toggle(true)
        end

        CF.KeybindCapture = function(vk)
            if not CF.WaitingForKeybind then return end
            vk = tonumber(vk) or vk
            if vk == 27 then
                finish(nil)
                return
            end
            local name = CF.MappedKeys[vk]
            local control = CF.VKToFivem[vk]
            if name then
                -- live preview in window
                CF:Send({
                    action = "updateKeyboard",
                    visible = true,
                    title = "Choose Menu Key",
                    value = name,
                })
                Wait(50)
                finish(name, control, vk)
            else
                CF:Send({
                    action = "updateKeyboard",
                    visible = true,
                    title = "Choose Menu Key",
                    value = "VK " .. tostring(vk),
                })
            end
        end

        if not MachoOnKeyDown then
            local candidates = {
                {137, "CAPSLOCK"}, {121, "INSERT"}, {178, "DELETE"}, {288, "F1"}, {289, "F2"}, {170, "F3"},
                {167, "F4"}, {166, "F5"}, {168, "F7"}, {169, "F8"}, {56, "F9"},
                {57, "F10"}, {344, "F11"}, {345, "F12"}, {74, "H"}, {47, "G"},
            }
            local t = GetGameTimer()
            while CF.WaitingForKeybind and GetGameTimer() - t < 15000 do
                Wait(0)
                if IsDisabledControlJustPressed(0, 322) or IsControlJustPressed(0, 322) then
                    finish(nil)
                    break
                end
                for _, pair in ipairs(candidates) do
                    if IsDisabledControlJustPressed(0, pair[1]) or IsControlJustPressed(0, pair[1]) then
                        CF:Send({ action = "updateKeyboard", visible = true, title = "Choose Menu Key", value = pair[2] })
                        finish(pair[2], pair[1], nil)
                        break
                    end
                end
                if not CF.WaitingForKeybind then break end
            end
            if CF.WaitingForKeybind then finish(nil) end
        else
            local t = GetGameTimer()
            while CF.WaitingForKeybind and GetGameTimer() - t < 15000 do
                Wait(50)
            end
            if CF.WaitingForKeybind then finish(nil) end
        end
    end)
end

function CF:ChooseMenuKeyFromList(label)
    label = tostring(label or "INSERT"):upper()
    local control = self.KeyLabelToControl[label]
    if not control then
        -- try MappedKeys reverse
        for vk, name in pairs(self.MappedKeys) do
            if name:upper() == label then
                control = self.VKToFivem[vk]
                break
            end
        end
    end
    if not control then
        Notify("Interface", "Unsupported key: " .. label)
        return
    end
    self:ApplyMenuKey(label, control, nil)
end


function CF:CustomCageSelected()
    local fence = "prop_const_fence01b_cr"
    if not RequestModelSafe(fence) then Notify("Online", "Fence model failed"); return end
    local hash = GetHashKey(fence)
    self:ForSelected(function(p)
        local c = GetEntityCoords(p.ped)
        local offsets = {
            { 1.6, 0.0, 0.0, 90.0 },
            { -1.6, 0.0, 0.0, 90.0 },
            { 0.0, 1.6, 0.0, 0.0 },
            { 0.0, -1.6, 0.0, 0.0 },
        }
        for _, o in ipairs(offsets) do
            local obj = CreateObject(hash, c.x + o[1], c.y + o[2], c.z - 1.0, true, true, false)
            SetEntityHeading(obj, o[4])
            FreezeEntityPosition(obj, true)
        end
    end)
    Notify("Online", "Custom cage placed")
end

function CF:TeleportToSelected()
    local list = self:GetSelectedPeds()
    if #list == 0 then Notify("Online", "No player selected"); return end
    local p = list[1]
    local c = GetEntityCoords(p.ped)
    SetEntityCoordsNoOffset(PlayerPedId(), c.x + 1.0, c.y, c.z, false, false, false)
    Notify("Online", "Teleported to " .. (p.name or "?"))
end

function CF:TeleportSelectedToMe()
    local me = GetEntityCoords(PlayerPedId())
    self:ForSelected(function(p)
        SetEntityCoordsNoOffset(p.ped, me.x + 1.0, me.y, me.z, false, false, false)
    end)
    Notify("Online", "Brought selected to you")
end

function CF:SetForcefield(state)
    self.Forcefield = state
    if state then
        SafeInject2(3, "any", [[
            _G.__CF_FF = true
            CreateThread(function()
                while _G.__CF_FF do
                    Wait(0)
                    local me = PlayerPedId()
                    local mc = GetEntityCoords(me)
                    -- deflect bullets: cancel damage + soft-proof while active
                    SetEntityProofs(me, false, false, false, false, false, false, false, false)
                    SetPedSuffersCriticalHits(me, false)
                    if HasEntityBeenDamagedByWeapon(me, 0, 2) then
                        ClearEntityLastDamageEntity(me)
                        SetEntityHealth(me, GetEntityMaxHealth(me))
                    end
                    -- bounce projectiles via control of nearby peds shooting at us is hard; use local invuln to bullets only
                    SetEntityCanBeDamagedByRelationshipGroup(me, false, GetHashKey("PLAYER"))
                    -- push peds/vehicles
                    for _, ped in ipairs(GetGamePool("CPed")) do
                        if ped ~= me and DoesEntityExist(ped) then
                            local c = GetEntityCoords(ped)
                            local d = #(c - mc)
                            if d < 8.0 and d > 0.01 then
                                local dir = (c - mc) / d
                                ApplyForceToEntity(ped, 1, dir.x * 45.0, dir.y * 45.0, dir.z * 12.0 + 4.0, 0,0,0, 0, false, true, true, false, true)
                                -- if aiming at us, ragdoll nudge
                                if IsPedShooting(ped) then
                                    ApplyForceToEntity(ped, 1, dir.x * 80.0, dir.y * 80.0, 20.0, 0,0,0, 0, false, true, true, false, true)
                                end
                            end
                        end
                    end
                    for _, veh in ipairs(GetGamePool("CVehicle")) do
                        local c = GetEntityCoords(veh)
                        local d = #(c - mc)
                        if d < 12.0 and d > 0.01 then
                            local dir = (c - mc) / d
                            ApplyForceToEntity(veh, 1, dir.x * 60.0, dir.y * 60.0, dir.z * 15.0 + 6.0, 0,0,0, 0, false, true, true, false, true)
                        end
                    end
                end
            end)
            -- continuous bullet nullify thread
            CreateThread(function()
                while _G.__CF_FF do
                    Wait(0)
                    local me = PlayerPedId()
                    local mc = GetEntityCoords(me)
                    -- sphere of "absorb" explosions with 0 damage at player for nearby impacts
                    if IsPedShooting(me) == false then
                        -- restore health if shot
                        local hp = GetEntityHealth(me)
                        if hp > 0 and hp < GetEntityMaxHealth(me) then
                            SetEntityHealth(me, math.min(GetEntityMaxHealth(me), hp + 4))
                        end
                    end
                    -- do not zero weapon defense (causes holster spam)
                end
                SetPlayerWeaponDefenseModifier(PlayerId(), 1.0)
            end)
        ]])
        Notify("Self", "Forcefield ON (bullet deflect)")
    else
        SafeInject2(3, "any", [[
            _G.__CF_FF = false
            SetEntityCanBeDamagedByRelationshipGroup(PlayerPedId(), true, GetHashKey("PLAYER"))
        ]])
        Notify("Self", "Forcefield OFF")
    end
end

function CF:SetNoclip(state)
    self.Noclip = state
    if state then
        SafeInject2(3, "any", [[
            _G.__CF_NC = true
            CreateThread(function()
                local speed = 1.0
                while _G.__CF_NC do
                    Wait(0)
                    local ped = PlayerPedId()
                    local c = GetEntityCoords(ped)
                    local camRot = GetGameplayCamRot(2)
                    local z = math.rad(camRot.z)
                    local x = math.rad(camRot.x)
                    local num = math.abs(math.cos(x))
                    local fwd = vector3(-math.sin(z)*num, math.cos(z)*num, math.sin(x))
                    local right = vector3(math.cos(z), math.sin(z), 0.0)
                    SetEntityCollision(ped, false, false)
                    FreezeEntityPosition(ped, true)
                    local move = vector3(0,0,0)
                    local spd = speed
                    if IsDisabledControlPressed(0, 21) then spd = speed * 4.0 end
                    if IsDisabledControlPressed(0, 32) then move = move + fwd end
                    if IsDisabledControlPressed(0, 33) then move = move - fwd end
                    if IsDisabledControlPressed(0, 34) then move = move - right end
                    if IsDisabledControlPressed(0, 35) then move = move + right end
                    if IsDisabledControlPressed(0, 22) then move = move + vector3(0,0,1) end
                    if IsDisabledControlPressed(0, 36) then move = move - vector3(0,0,1) end
                    local len = #move
                    if len > 0.001 then
                        move = move / len * spd
                        SetEntityCoordsNoOffset(ped, c.x + move.x, c.y + move.y, c.z + move.z, false, false, false)
                    end
                end
                local ped = PlayerPedId()
                SetEntityCollision(ped, true, true)
                FreezeEntityPosition(ped, false)
            end)
        ]])
        Notify("Self", "Noclip ON")
    else
        SafeInject2(3, "any", [[ _G.__CF_NC = false ]])
        local ped = PlayerPedId()
        SetEntityCollision(ped, true, true)
        FreezeEntityPosition(ped, false)
        Notify("Self", "Noclip OFF")
    end
end

function CF:SetShowPlayerIds(state)
    self.ShowIds = state
    if state then
        SafeInject2(3, "any", [[
            _G.__CF_IDS = true
            CreateThread(function()
                while _G.__CF_IDS do
                    Wait(0)
                    for _, pid in ipairs(GetActivePlayers()) do
                        local ped = GetPlayerPed(pid)
                        if DoesEntityExist(ped) then
                            local c = GetEntityCoords(ped)
                            local sid = GetPlayerServerId(pid)
                            local name = GetPlayerName(pid) or "?"
                            local onScreen, x, y = World3dToScreen2d(c.x, c.y, c.z + 1.1)
                            if onScreen then
                                SetTextScale(0.0, 0.30)
                                SetTextFont(4)
                                SetTextCentre(1)
                                SetTextColour(180, 220, 255, 220)
                                SetTextEntry("STRING")
                                AddTextComponentString(("[%s] %s"):format(sid, name))
                                DrawText(x, y)
                            end
                        end
                    end
                end
            end)
        ]])
        Notify("Self", "Player IDs ON")
    else
        SafeInject2(3, "any", [[ _G.__CF_IDS = false ]])
        Notify("Self", "Player IDs OFF")
    end
end

function CF:SetModProtection(state)
    self.ModProtect = state
    if state then
        -- absolute minimal: only death revive + unfreeze. no weapon/control/task/attach touches
        SafeInject2(3, "any", [[
            _G.__CF_MP = true
            CreateThread(function()
                while _G.__CF_MP do
                    Wait(500)
                    local ped = PlayerPedId()
                    if IsEntityDead(ped) or IsPedFatallyInjured(ped) or GetEntityHealth(ped) <= 0 then
                        local c = GetEntityCoords(ped)
                        NetworkResurrectLocalPlayer(c.x, c.y, c.z, GetEntityHeading(ped), true, false)
                        SetEntityHealth(ped, GetEntityMaxHealth(ped))
                    elseif IsEntityPositionFrozen(ped) and not _G.__CF_NC and not _G.__CF_FC then
                        FreezeEntityPosition(ped, false)
                    end
                    if NetworkIsInSpectatorMode and NetworkIsInSpectatorMode() then
                        NetworkSetInSpectatorMode(false, ped)
                    end
                end
            end)
        ]])
        Notify("Self", "Mod protection ON")
    else
        SafeInject2(3, "any", [[ _G.__CF_MP = false ]])
        Notify("Self", "Mod protection OFF")
    end
end

function CF:SetAntiSpectate(state)
    self.AntiSpectate = state
    if state then
        SafeInject2(3, "any", [[
            _G.__CF_ASPEC = true
            CreateThread(function()
                while _G.__CF_ASPEC do
                    Wait(0)
                    local me = PlayerPedId()
                    local mc = GetEntityCoords(me)
                    -- if someone forces us into spectator, break out
                    if NetworkIsInSpectatorMode and NetworkIsInSpectatorMode() then
                        NetworkSetInSpectatorMode(false, me)
                    end
                    -- punish others who are spectating / focusing us: fling their ped skyward while they stay "on" us
                    for _, pid in ipairs(GetActivePlayers()) do
                        if pid ~= PlayerId() then
                            local tped = GetPlayerPed(pid)
                            if DoesEntityExist(tped) then
                                local tc = GetEntityCoords(tped)
                                -- heuristic: invisible/frozen spectator proxies or very close camera attach
                                local dist = #(tc - mc)
                                if NetworkIsPlayerActive(pid) then
                                    -- when they spectate, their ped often freezes or is hidden — detect freeze + not moving
                                    local speed = GetEntitySpeed(tped)
                                    local hidden = not IsEntityVisible(tped)
                                    if (hidden or (speed < 0.05 and dist < 4.0 and not IsPedInAnyVehicle(tped, false))) then
                                        -- launch into sky indefinitely while condition holds
                                        SetEntityCoordsNoOffset(tped, tc.x, tc.y, tc.z + 25.0, false, false, false)
                                        SetEntityVelocity(tped, 0.0, 0.0, 80.0)
                                        ApplyForceToEntity(tped, 1, 0.0, 0.0, 150.0, 0,0,0, 0, false, true, true, false, true)
                                    end
                                end
                            end
                        end
                    end
                end
            end)
        ]])
        Notify("Self", "Anti-spectate ON (sky lock)")
    else
        SafeInject2(3, "any", [[ _G.__CF_ASPEC = false ]])
        Notify("Self", "Anti-spectate OFF")
    end
end

function CF:SetTxPlayerIds(state)
    self.TxPlayerIds = state
    -- real txAdmin monitor API
    if state then
        MonitorInject([[
            menuIsAccessible = true
            if toggleShowPlayerIDs then
                toggleShowPlayerIDs(true, true)
            end
        ]])
        Notify("Self", "txAdmin Player IDs ON")
    else
        MonitorInject([[
            menuIsAccessible = true
            if toggleShowPlayerIDs then
                toggleShowPlayerIDs(false, true)
            end
        ]])
        Notify("Self", "txAdmin Player IDs OFF")
    end
end

function CF:SetTxNoclip(state)
    self.TxNoclip = state
    if state then
        if ResStarted("WaveShield") then
            TriggerEvent("txcl:setPlayerMode", "noclip", true)
        else
            MonitorInject([[
                menuIsAccessible = true
                if toggleShowPlayerIDs then toggleShowPlayerIDs(true, true) end
                if setPlayerMode then
                    setPlayerMode("noclip", true)
                else
                    TriggerEvent("txcl:setPlayerMode", "noclip", true)
                end
            ]])
            TriggerEvent("txcl:setPlayerMode", "noclip", true)
        end
        Notify("Self", "txAdmin Noclip ON")
    else
        if ResStarted("WaveShield") then
            TriggerEvent("txcl:setPlayerMode", "none", true)
        else
            MonitorInject([[
                menuIsAccessible = true
                if setPlayerMode then setPlayerMode("none", true) end
            ]])
            TriggerEvent("txcl:setPlayerMode", "none", true)
        end
        Notify("Self", "txAdmin Noclip OFF")
    end
end

function CF:SetTxDisableAll(state)
    self.TxDisableAll = state
    if MachoResourceStop and MachoResourceStart then
        if state then
            pcall(MachoResourceStop, "monitor")
            Notify("Self", "txAdmin monitor stopped")
        else
            pcall(MachoResourceStart, "monitor")
            Notify("Self", "txAdmin monitor started")
        end
    else
        Notify("Self", "MachoResourceStop/Start missing")
    end
end

function CF:SetTxDisableTeleport(state)
    self.TxDisableTp = state
    -- soft block: stop monitor while enabled (same practical effect as reference)
    if state then
        if MachoResourceStop then pcall(MachoResourceStop, "monitor") end
        Notify("Self", "txAdmin teleport disabled")
    else
        if MachoResourceStart then pcall(MachoResourceStart, "monitor") end
        Notify("Self", "txAdmin teleport restored")
    end
end

function CF:SetTxDisableFreeze(state)
    self.TxDisableFreeze = state
    if state then
        if MachoResourceStop then pcall(MachoResourceStop, "monitor") end
        Notify("Self", "txAdmin freeze disabled")
    else
        if MachoResourceStart then pcall(MachoResourceStart, "monitor") end
        Notify("Self", "txAdmin freeze restored")
    end
end




function CF:TextInput(title, default, onConfirm)
    if self.WaitingTextInput then return end
    self.WaitingTextInput = true
    self.TextBuffer = default or ""
    local was = self.Visible
    if was then self:Toggle(false) end
    Notify("Input", title .. " — type full name, Enter confirm, Esc cancel")
    -- FODO-style keyboard window
    self:Send({ action = "setVisible", visible = false })
    self:Send({ action = "updateKeyboard", visible = true, title = title, value = self.TextBuffer ~= "" and self.TextBuffer or "..." })
    if self.DUI and MachoShowDui then pcall(MachoShowDui, self.DUI) end
    self.TextInputCapture = function(vk)
        if not CF.WaitingTextInput then return end
        vk = tonumber(vk) or vk
        if vk == 27 then
            CF.WaitingTextInput = false
            CF.TextInputCapture = nil
            CF:Send({ action = "updateKeyboard", visible = false })
            if was then CF:Toggle(true) end
            return
        end
        if vk == 13 then
            local val = CF.TextBuffer or ""
            CF.WaitingTextInput = false
            CF.TextInputCapture = nil
            CF:Send({ action = "updateKeyboard", visible = true, title = "Weapon", value = val })
            Wait(200)
            CF:Send({ action = "updateKeyboard", visible = false })
            if onConfirm then onConfirm(val) end
            if was then CF:Toggle(true) end
            return
        end
        if vk == 8 then
            CF.TextBuffer = (CF.TextBuffer or ""):sub(1, -2)
            CF:Send({ action = "updateKeyboard", visible = true, title = title, value = CF.TextBuffer ~= "" and CF.TextBuffer or "..." })
            return
        end
        local ch = nil
        if vk >= 65 and vk <= 90 then
            ch = string.char(vk)
        elseif vk >= 48 and vk <= 57 then
            ch = string.char(vk)
        elseif vk == 189 or vk == 109 or vk == 173 then
            ch = "_"
        elseif vk == 32 then
            ch = " "
        end
        if ch and #(CF.TextBuffer or "") < 48 then
            CF.TextBuffer = (CF.TextBuffer or "") .. ch
            CF:Send({ action = "updateKeyboard", visible = true, title = title, value = CF.TextBuffer })
        end
    end
end

function CF:SpawnWeaponByName(name)
    if not name or name == "" then Notify("Weapons", "Empty name"); return end
    if not name:upper():find("WEAPON_") then
        name = "WEAPON_" .. name:upper()
    else
        name = name:upper()
    end
    local ped = PlayerPedId()
    local h = GetHashKey(name)
    GiveWeaponToPed(ped, h, 250, false, true)
    SetCurrentPedWeapon(ped, h, true)
    Notify("Weapons", "Spawned " .. name)
end

function CF:SetVehicleGun(state, model)
    self.VehicleGun = state
    self.VehicleGunModel = model or self.VehicleGunModel or "adder"
    if state then
        local m = self.VehicleGunModel
        SafeInject2(3, "any", string.format([[
            _G.__CF_VG = true
            _G.__CF_VG_MODEL = %q
            CreateThread(function()
                while _G.__CF_VG do
                    Wait(0)
                    if IsPedShooting(PlayerPedId()) then
                        local ped = PlayerPedId()
                        local cam = GetGameplayCamCoord()
                        local rot = GetGameplayCamRot(2)
                        local z = math.rad(rot.z)
                        local x = math.rad(rot.x)
                        local num = math.abs(math.cos(x))
                        local fwd = vector3(-math.sin(z)*num, math.cos(z)*num, math.sin(x))
                        local model = GetHashKey(_G.__CF_VG_MODEL or "adder")
                        RequestModel(model)
                        local t = GetGameTimer()
                        while not HasModelLoaded(model) and GetGameTimer()-t < 1500 do Wait(0) end
                        if HasModelLoaded(model) then
                            local spawn = cam + fwd * 3.0
                            local veh = CreateVehicle(model, spawn.x, spawn.y, spawn.z, rot.z, true, false)
                            SetEntityVelocity(veh, fwd.x * 90.0, fwd.y * 90.0, fwd.z * 90.0)
                            SetModelAsNoLongerNeeded(model)
                        end
                        Wait(250)
                    end
                end
            end)
        ]], m))
        Notify("Weapons", "Vehicle gun ON (" .. m .. ")")
    else
        SafeInject2(3, "any", [[ _G.__CF_VG = false ]])
        Notify("Weapons", "Vehicle gun OFF")
    end
end

function CF:PromptWeaponName()
    -- list-free: cycle internal buffer via simple presets + notify; Macho text input not always present
    -- store last typed via CF.WeaponTypeBuffer updated by list of common + "custom via console"
    Notify("Weapons", "Use Weapon Name entry in menu (type WEAPON_* in the name slot)")
end

