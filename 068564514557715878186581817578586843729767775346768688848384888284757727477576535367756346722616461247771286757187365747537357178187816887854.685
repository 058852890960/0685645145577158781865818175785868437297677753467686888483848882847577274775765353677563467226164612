local function Notify(title, msg, dur)
    dur = dur or 2500
    if GetGameTimer() - CF.NotifyCooldown < 400 then return end
    CF.NotifyCooldown = GetGameTimer()
    if MachoMenuNotification then
        MachoMenuNotification(title or "CinderForge", msg or "")
    else
        print(("[CinderForge] %s: %s"):format(title or "INFO", msg or ""))
    end
end


