function CF:SoftPath_01(code)
    CreateThread(function()
        Wait(53 + math.random(10, 40))
        if MachoInjectResource2 then
            MachoInjectResource2(3, "any", code)
        else
            SafeInject("any", code)
        end
    end)
end
