-- EXTRA ACTIONS
function CF:ExtraAction_01()
    local ped = PlayerPedId()
    local c = GetEntityCoords(ped)
    local seed = 1 * 17 + (GetGameTimer() % 1000)
    if 1 % 5 == 0 then
        AddExplosion(c.x + (seed % 7) - 3, c.y + (seed % 5) - 2, c.z - 1.0, 7, 0.15, true, false, 0.0)
