        btn("Money Rain (visual bags)", function()
            if RequestModelSafe("prop_money_bag_01") then
                local c = GetEntityCoords(PlayerPedId())
                local hash = GetHashKey("prop_money_bag_01")
                CreateThread(function()
                    for i = 1, 50 do
                        local x = c.x + math.random(-12, 12)
                        local y = c.y + math.random(-12, 12)
                        local z = c.z + 30.0 + math.random(0, 20)
                        local o = CreateObject(hash, x, y, z, true, true, false)
                        SetEntityDynamic(o, true)
                        ActivatePhysics(o)
                        SetEntityVelocity(o, (math.random()-0.5)*2.0, (math.random()-0.5)*2.0, -22.0)
                        ApplyForceToEntity(o, 1, 0.0, 0.0, -40.0, 0,0,0, 0, false, true, true, false, true)
                        if i % 10 == 0 then Wait(0) end
                    end
                    for i = 1, 25 do
                        local o = CreateObject(hash, c.x + math.random(-10,10), c.y + math.random(-10,10), c.z - 0.9, true, true, false)
                        PlaceObjectOnGroundProperly(o)
                        FreezeEntityPosition(o, true)
                    end
                end)
            end
            Notify("Spawn", "Money raining from sky + floor piles")
        end),
        btn("Clone Army (100x self)", function()
            local me = PlayerPedId()
            local model = GetEntityModel(me)
            RequestModel(model)
            local t = GetGameTimer()
            while not HasModelLoaded(model) and GetGameTimer() - t < 3000 do Wait(0) end
            if not HasModelLoaded(model) then Notify("Spawn", "Model load failed"); return end
            local c = GetEntityCoords(me)
            local heading = GetEntityHeading(me)
            CreateThread(function()
                local spawned = 0
                for i = 1, 100 do
                    local clone = CreatePed(4, model, c.x, c.y, c.z, heading, true, true)
                    if not clone or clone == 0 then
                        clone = ClonePed(me, heading, true, true)
                    end
                    if clone and clone ~= 0 then
                        local ang = (i / 100) * math.pi * 2
                        local r = 3.0 + (i % 15) * 0.45
                        SetEntityAsMissionEntity(clone, true, true)
                        SetEntityCoordsNoOffset(clone, c.x + math.cos(ang) * r, c.y + math.sin(ang) * r, c.z, false, false, false)
                        SetPedComponentVariation(clone, 0, GetPedDrawableVariation(me, 0), 0, 0)
                        spawned = spawned + 1
                    end
                    if i % 8 == 0 then Wait(20) end
                end
                SetModelAsNoLongerNeeded(model)
                Notify("Spawn", "Cloned " .. tostring(spawned) .. "/100")
            end)
        end),
