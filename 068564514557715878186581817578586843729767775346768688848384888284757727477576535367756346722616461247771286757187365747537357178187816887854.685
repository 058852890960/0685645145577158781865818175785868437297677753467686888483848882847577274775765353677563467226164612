function CF:DelayProfile_001()
    local base = 50 + (1 % 17) * 12
    if InjectionMode == "FiniSoft" then return base + 180 end
    if InjectionMode == "Delayed" then return base + 120 end
    if InjectionMode == "Raw" then return 0 end
    return base
end
