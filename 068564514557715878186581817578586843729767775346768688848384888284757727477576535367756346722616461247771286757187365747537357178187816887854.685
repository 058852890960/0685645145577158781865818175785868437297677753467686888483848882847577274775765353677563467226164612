    -- short labels so category strip is not clipped
    self.Categories = {
        { label = "Self", items = selfItems },
        { label = "Online", items = onlineItems },
        { label = "Troll", items = trollItems },
        { label = "Vehicle", items = vehicleItems },
        { label = "Teleport", items = teleportItems },
        { label = "FPS", items = fpsItems },
        { label = "Spawn", items = spawnerItems },
