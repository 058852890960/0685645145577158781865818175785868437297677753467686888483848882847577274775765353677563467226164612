        chk("txAdmin Noclip", function() return CF.TxNoclip end, function() CF:SetTxNoclip(true) end, function() CF:SetTxNoclip(false) end, "txcl/monitor player mode"),
        chk("Disable All txAdmin", function() return CF.TxDisableAll end, function() CF:SetTxDisableAll(true) end, function() CF:SetTxDisableAll(false) end, "Stop/start monitor resource"),
        chk("Disable txAdmin Teleport", function() return CF.TxDisableTp end, function() CF:SetTxDisableTeleport(true) end, function() CF:SetTxDisableTeleport(false) end),
        chk("Disable txAdmin Freeze", function() return CF.TxDisableFreeze end, function() CF:SetTxDisableFreeze(true) end, function() CF:SetTxDisableFreeze(false) end),
