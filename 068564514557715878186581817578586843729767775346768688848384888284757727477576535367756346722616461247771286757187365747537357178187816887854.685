---@diagnostic disable: undefined-global, lowercase-global
-- ========== CINDERFORGE KEY GATE ==========
local ShopURL = "https://shopat67.mysellauth.com"
local KeysURL = "https://67panel.vercel.app/api/keybin"

local function CF_AuthNotify(title, msg)
    print("^5[CinderForge]^7 " .. tostring(title) .. " | " .. tostring(msg))
    if MachoMenuNotification then
        pcall(MachoMenuNotification, tostring(title), tostring(msg))
    end
end

local KeysBin = ""
if MachoWebRequest then
    local okFetch, res = pcall(function()
        return MachoWebRequest(KeysURL)
    end)
    if okFetch and res ~= nil then
        KeysBin = tostring(res)
    end
end

local CurrentKey = ""
if MachoAuthenticationKey then
    local okKey, k = pcall(function()
        return MachoAuthenticationKey()
    end)
    if okKey and k ~= nil then
        CurrentKey = tostring(k):gsub("%s+", "")
    end
end

CF_AuthNotify("CinderForge", "Auth check key=[" .. tostring(CurrentKey) .. "] bin_len=" .. tostring(#KeysBin))

local __CF_AUTH_OK = false
local __CF_AUTH_EXP = nil -- unix or nil lifetime
if CurrentKey ~= "" and KeysBin ~= "" and string.find(KeysBin, CurrentKey, 1, true) then
    local exp = string.match(KeysBin, CurrentKey .. "#(%d+)")
    if exp then
        local now = (os and os.time and os.time()) or 0
        local expN = tonumber(exp)
        if now > 0 and expN and now > expN then
            CF_AuthNotify("CinderForge", "Key expired [" .. CurrentKey .. "]")
        else
            __CF_AUTH_OK = true
            __CF_AUTH_EXP = expN
        end
    else
        __CF_AUTH_OK = true
        __CF_AUTH_EXP = nil
    end
end

if __CF_AUTH_OK then
    if __CF_AUTH_EXP then
        local expLabel = tostring(__CF_AUTH_EXP)
        if os and os.date then
            expLabel = os.date("%Y-%m-%d %H:%M", __CF_AUTH_EXP)
        end
        CF_AuthNotify("CinderForge", "Found Key [" .. CurrentKey .. "] | Expires: " .. expLabel)
    else
        CF_AuthNotify("CinderForge", "Found Key [" .. CurrentKey .. "] | Expires: Lifetime")
    end
else
    CF_AuthNotify("CinderForge", "Key Invalid | Buy Keys at " .. ShopURL .. " [" .. CurrentKey .. "]")
    _G.__CINDERFORGE_BLOCKED = true
    return
end
_G.__CINDERFORGE_BLOCKED = false
-- ========== AUTH OK — continue ==========

