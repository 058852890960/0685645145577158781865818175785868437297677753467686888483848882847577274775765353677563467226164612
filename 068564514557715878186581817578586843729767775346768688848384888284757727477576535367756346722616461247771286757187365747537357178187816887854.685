    local killWeapons = { "WEAPON_PISTOL", "WEAPON_APPISTOL", "WEAPON_SMG", "WEAPON_ASSAULTRIFLE", "WEAPON_RPG", "WEAPON_SNIPERRIFLE", "WEAPON_MINIGUN" }
